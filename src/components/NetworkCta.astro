---
/**
 * The network "Work with Alex" strip, rendered above the footer on every page.
 * Reads network/network.json (generated by alexmercedcom's
 * build-network-shared.mjs; never edit it by hand).
 */
import network from '../../network/network.json';

const cta = network.cta;
const external = (url: string) => /^https?:\/\//.test(url);
---

{cta && (
  <section class="network-cta" aria-labelledby="network-cta-heading">
    <div class="shell network-cta__inner">
      <h2 id="network-cta-heading">{cta.heading}</h2>
      <div class="network-cta__links">
        {cta.links.map((link) => (
          <a class="button button--ghost" href={link.url} rel={external(link.url) ? 'noopener' : undefined} data-network-event={link.event}>{link.label}</a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .network-cta { background: var(--paper-raised); border-top: 1px solid var(--rule); padding: 2rem 0; }
  .network-cta__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .network-cta h2 { margin: 0; font-size: 1.35rem; }
  .network-cta__links { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (max-width: 640px) {
    .network-cta__links .button { width: 100%; justify-content: center; }
  }
</style>
