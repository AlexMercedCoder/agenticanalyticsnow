---
/**
 * The site's thesis, drawn as an equation. Three animated glyphs in a grid
 * rather than one wide SVG, so the whole thing reflows to a single column on a
 * phone instead of shrinking its own labels into illegibility.
 */
---

<figure class="eq" role="img" aria-labelledby="eq-title" aria-describedby="eq-desc">
  <figcaption class="visually-hidden">
    <span id="eq-title">Agentic analytics as an equation</span>
    <span id="eq-desc">
      AI agents, plus unified governed semantic data held in an open lakehouse, equals agentic
      analytics: answers a business can act on.
    </span>
  </figcaption>

  <div class="eq__term eq__term--agent">
    <svg viewBox="0 0 160 160" aria-hidden="true" class="glyph glyph--agent">
      <circle class="a-halo" cx="80" cy="66" r="34" />
      <circle class="a-core" cx="80" cy="66" r="21" />
      <g class="a-orbit">
        <circle class="a-tool" cx="80" cy="18" r="7" />
        <circle class="a-tool a-tool--2" cx="121" cy="90" r="7" />
        <circle class="a-tool a-tool--3" cx="39" cy="90" r="7" />
      </g>
      <path class="a-loop" d="M80 100v18" />
      <rect class="a-step" x="44" y="122" width="72" height="8" rx="4" />
      <rect class="a-step a-step--2" x="52" y="138" width="56" height="8" rx="4" />
    </svg>
    <strong>AI agents</strong>
    <span>Plan, call tools, check the result, try again.</span>
  </div>

  <div class="eq__op" aria-hidden="true">+</div>

  <div class="eq__term eq__term--data">
    <svg viewBox="0 0 160 160" aria-hidden="true" class="glyph glyph--data">
      <g class="d-stack">
        <rect class="d-band d-band--semantic" x="20" y="26" width="120" height="22" rx="5" />
        <rect class="d-band d-band--catalog" x="20" y="58" width="120" height="22" rx="5" />
        <rect class="d-band d-band--table" x="20" y="90" width="120" height="22" rx="5" />
        <rect class="d-band d-band--file" x="20" y="122" width="120" height="22" rx="5" />
      </g>
      <circle class="d-scan" cx="34" cy="37" r="4" />
    </svg>
    <strong>Governed semantic data</strong>
    <span>One definition of the metric, one place access is decided.</span>
  </div>

  <div class="eq__op" aria-hidden="true">=</div>

  <div class="eq__term eq__term--result">
    <svg viewBox="0 0 160 160" aria-hidden="true" class="glyph glyph--result">
      <rect class="r-card" x="16" y="24" width="128" height="112" rx="9" />
      <rect class="r-bar" x="36" y="60" width="18" height="56" rx="3" />
      <rect class="r-bar r-bar--2" x="62" y="60" width="18" height="56" rx="3" />
      <rect class="r-bar r-bar--3" x="88" y="60" width="18" height="56" rx="3" />
      <rect class="r-bar r-bar--4" x="114" y="60" width="18" height="56" rx="3" />
      <path class="r-check" d="M40 44h80" />
    </svg>
    <strong>Agentic analytics</strong>
    <span>An answer with its lineage attached, not a guess.</span>
  </div>
</figure>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }

  .eq {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
  }

  .eq__op {
    font: 700 2rem/1 var(--display);
    color: var(--ink-faint);
    align-self: center;
    padding-top: 1.5rem;
  }

  .eq__term {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.35rem;
    padding: 1.25rem 0.9rem 1.4rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--rule);
    border-radius: var(--radius);
  }
  .eq__term--agent { border-top-color: var(--agent); }
  .eq__term--data { border-top-color: var(--data); }
  .eq__term--result { border-top-color: var(--result); }

  .eq__term strong { font-family: var(--display); font-size: 1.05rem; letter-spacing: -0.02em; }
  .eq__term span { font-size: 0.85rem; color: var(--ink-soft); line-height: 1.45; }

  .glyph { width: 100%; max-width: 132px; height: auto; }

  /* ------------------------------------------------------- agent glyph */
  .a-halo { fill: none; stroke: var(--agent); stroke-width: 1.5; opacity: .28; animation: breathe 3.6s ease-in-out infinite; transform-origin: 80px 66px; }
  .a-core { fill: var(--agent); animation: pulse 3.6s ease-in-out infinite; transform-origin: 80px 66px; }
  .a-orbit { transform-origin: 80px 66px; animation: spin 14s linear infinite; }
  .a-tool { fill: var(--void-700); }
  .a-tool--2 { fill: var(--signal); }
  .a-tool--3 { fill: var(--data); }
  .a-loop { stroke: var(--agent); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 4 5; animation: trickle 1.4s linear infinite; }
  .a-step { fill: var(--void-700); opacity: .25; animation: blink 3.6s ease-in-out infinite; }
  .a-step--2 { animation-delay: .45s; }

  /* -------------------------------------------------------- data glyph */
  .d-band { opacity: .9; animation: settle 3.6s ease-in-out infinite; }
  .d-band--semantic { fill: var(--result); animation-delay: 0s; }
  .d-band--catalog { fill: var(--signal); animation-delay: .2s; }
  .d-band--table { fill: var(--data); animation-delay: .4s; }
  .d-band--file { fill: var(--void-600); animation-delay: .6s; }
  .d-scan { fill: #fff; opacity: .9; animation: sweep 3.6s ease-in-out infinite; }

  /* ------------------------------------------------------ result glyph */
  .r-card { fill: none; stroke: var(--result); stroke-width: 2; opacity: .55; }
  .r-bar { fill: var(--result); transform-origin: 50% 116px; animation: grow 3.6s ease-in-out infinite; }
  .r-bar--2 { animation-delay: .12s; opacity: .85; }
  .r-bar--3 { animation-delay: .24s; opacity: .7; }
  .r-bar--4 { animation-delay: .36s; opacity: .55; }
  .r-check { stroke: var(--data); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 80; animation: draw 3.6s ease-in-out infinite; }

  @keyframes breathe { 0%, 100% { transform: scale(1); opacity: .28; } 50% { transform: scale(1.12); opacity: .12; } }
  @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.07); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes trickle { to { stroke-dashoffset: -18; } }
  @keyframes blink { 0%, 40%, 100% { opacity: .2; } 55% { opacity: .55; } }
  @keyframes settle { 0%, 100% { opacity: .55; } 45% { opacity: 1; } }
  @keyframes sweep { 0% { transform: translate(0, 0); } 45% { transform: translate(92px, 96px); } 60% { transform: translate(92px, 96px); } 100% { transform: translate(0, 0); } }
  @keyframes grow { 0%, 100% { transform: scaleY(.35); } 55% { transform: scaleY(1); } }
  @keyframes draw { 0% { stroke-dashoffset: 80; } 45%, 100% { stroke-dashoffset: 0; } }

  @media (max-width: 820px) {
    .eq { grid-template-columns: 1fr; gap: 0.5rem; }
    .eq__op { justify-self: center; padding: 0.2rem 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .a-halo, .a-core, .a-orbit, .a-loop, .a-step, .d-band, .d-scan, .r-bar, .r-check { animation: none; }
    .a-halo { opacity: .28; }
    .d-band { opacity: 1; }
    .r-bar { transform: scaleY(1); }
    .r-check { stroke-dashoffset: 0; }
  }
</style>
