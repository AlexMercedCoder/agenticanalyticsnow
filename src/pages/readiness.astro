---
import Base from '../layouts/Base.astro';
import LeaderTools from '../components/LeaderTools.astro';
import {
  readinessAreas,
  readinessLevels,
  READINESS_WEAK_CAP,
  READINESS_STRONG,
} from '../data/leader-tools';

const SITE = 'https://agenticanalyticsnow.com';
const url = `${SITE}/readiness/`;
const total = readinessAreas.reduce((n, area) => n + area.questions.length, 0);

const faq = [
  {
    q: 'Do my answers leave the browser?',
    a: 'No. The scoring runs in JavaScript on this page and nothing is sent to a server. The share link keeps your answers in the part of the address after the # sign, which browsers do not send to the site. Google Analytics measures visits to this site and records that the assessment was started and finished, and the level reached, but not your answers.',
  },
  {
    q: 'How is the score calculated?',
    a: `Each answer scores 0 to 3, from the first option to the last. Each of the five areas is scored out of 9, and the overall score is out of ${total * 3}. The level comes from the overall percentage: Exploring below 40%, Building from 40%, Ready from 65%, Scaling from 85%. One rule overrides it: if any area scores 3 or less out of 9, the level cannot be higher than Building, because an agent fails at the weakest point, not the average.`,
  },
  {
    q: 'Who should fill it in?',
    a: 'The person accountable for analytics, ideally with the data platform lead and an analytics engineer in the room. The disagreements between them are often more useful than the score.',
  },
  {
    q: 'What should I do with the result?',
    a: 'Work on the areas listed under next steps before scaling anything. If the level is Ready or Scaling, the 90-day rollout playbook is the next page to read. Save the share link and take the assessment again after the pilot to compare.',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    url,
    name: 'Agentic analytics readiness assessment',
    description:
      'A 15-question self-assessment for analytics leaders covering semantic layer, governance, data quality, open interfaces, and team. Scored in the browser into a maturity level with next steps.',
    isPartOf: { '@id': `${SITE}/#website` },
    author: { '@id': 'https://alexmerced.com/#alexmerced' },
    inLanguage: 'en-US',
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Readiness assessment', item: url },
    ],
  },
];

const clientData = {
  areas: readinessAreas.map((area) => ({
    id: area.id,
    title: area.title,
    questions: area.questions.map((q) => q.id),
    nextSteps: area.nextSteps,
  })),
  levels: readinessLevels,
  weakCap: READINESS_WEAK_CAP,
  strong: READINESS_STRONG,
};

let n = 0;
---

<Base
  title="Agentic Analytics Readiness Assessment"
  description="Fifteen questions for analytics leaders on semantic layer, governance, data quality, open interfaces, and team. Scored in your browser into a maturity level with specific next steps. Nothing leaves the page."
  jsonLd={jsonLd}
  keywords={['agentic analytics readiness', 'AI readiness assessment', 'analytics maturity', 'semantic layer', 'data governance', 'AI agents']}
>
  <section class="tool-head">
    <div class="shell">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Readiness assessment</span></nav>
      <p class="eyebrow">Readiness assessment</p>
      <h1>Is your data ready for analytics agents?</h1>
      <p class="tool-head__lede">
        Fifteen questions across the five things that decide whether an agent gives right answers:
        definitions, access, data quality, interfaces, and the team that runs it. Pick the answer
        closest to how things work today, not how they are meant to work. It takes about ten
        minutes.
      </p>
      <p class="tool-head__note">
        Scored in your browser. Your answers are not sent anywhere; the result link keeps them in
        the address after the # sign.
      </p>
    </div>
  </section>

  <div class="shell readiness">
    <noscript><p class="form-error">The scoring needs JavaScript. The questions below, and the scoring rule under "About this assessment", still work on paper.</p></noscript>
    <form id="readiness-form" class="readiness__form" novalidate>
      {readinessAreas.map((area, areaIndex) => (
        <section class="area" aria-labelledby={`area-${area.id}`}>
          <p class="area__count">Area {areaIndex + 1} of {readinessAreas.length}</p>
          <h2 id={`area-${area.id}`}>{area.title}</h2>
          <p class="area__why">{area.why}</p>
          {area.questions.map((question) => {
            n += 1;
            return (
              <fieldset class="question" id={`fs-${question.id}`}>
                <legend><span class="question__num">{n}.</span> {question.text}</legend>
                <div class="options">
                  {question.options.map((option, value) => (
                    <label class="option">
                      <input type="radio" name={question.id} value={value} required />
                      <span>{option}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            );
          })}
        </section>
      ))}

      <div class="submit-bar">
        <p class="submit-bar__progress" id="progress" aria-live="polite">0 of {total} answered</p>
        <button type="submit" class="button">See my result</button>
      </div>
      <p class="form-error" id="form-error" role="alert" tabindex="-1" hidden></p>
    </form>

    <section class="result" id="result" aria-labelledby="result-heading" tabindex="-1" hidden>
      <p class="eyebrow">Your result</p>
      <h2 id="result-heading"><span id="result-level"></span></h2>
      <p class="result__score" id="result-score"></p>
      <p class="result__summary" id="result-summary"></p>
      <p class="result__cap" id="result-cap" hidden></p>
      <p class="result__focus" id="result-focus"></p>

      <h3>By area</h3>
      <ul class="bars" id="result-bars"></ul>

      <div id="result-steps"></div>

      <div class="result__next">
        <h3>Then</h3>
        <ul>
          <li><a href="/rollout-playbook/">The 90-day rollout playbook</a>: phases, owners, and exit criteria for a first domain.</li>
          <li><a href="/use-cases/">The use-case library</a>: pick the domain and the first questions.</li>
          <li><a href="/evaluation-checklist/">The evaluation checklist</a>: what to ask vendors, once the foundations are in place.</li>
        </ul>
      </div>

      <div class="share">
        <label for="share-url">Link to this result</label>
        <div class="share__row">
          <input id="share-url" type="text" readonly />
          <button type="button" class="button button--ghost" id="copy-link">Copy link</button>
        </div>
        <p class="share__status" id="copy-status" aria-live="polite"></p>
        <button type="button" class="linkish" id="restart">Clear answers and start over</button>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">About this assessment</h2>
      {faq.map((item) => (
        <div class="faq__item">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
        </div>
      ))}
    </section>
  </div>

  <LeaderTools heading="The other leader tools" exclude="readiness" />

  <script type="application/json" id="readiness-data" set:html={JSON.stringify(clientData)} />
</Base>

<script>
  type Link = { label: string; href: string };
  type Area = { id: string; title: string; questions: string[]; nextSteps: { text: string; links: Link[] }[] };
  type Level = { id: string; name: string; min: number; summary: string; focus: string };
  type Data = { areas: Area[]; levels: Level[]; weakCap: number; strong: number };

  const data: Data = JSON.parse(document.getElementById('readiness-data')!.textContent || '{}');
  const form = document.getElementById('readiness-form') as HTMLFormElement;
  const progress = document.getElementById('progress')!;
  const error = document.getElementById('form-error')!;
  const result = document.getElementById('result')!;
  const questionIds = data.areas.flatMap((a) => a.questions);
  const TOTAL = questionIds.length;

  const gtagEvent = (name: string, params: Record<string, unknown> = {}) => {
    const g = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
    if (typeof g === 'function') g('event', name, params);
  };

  const readAnswers = (): (number | null)[] =>
    questionIds.map((id) => {
      const checked = form.querySelector<HTMLInputElement>(`input[name="${id}"]:checked`);
      return checked ? Number(checked.value) : null;
    });

  const encode = (answers: (number | null)[]) => answers.map((a) => (a === null ? '-' : String(a))).join('');

  const decode = (hash: string): number[] | null => {
    const match = /(?:^|[#&])answers=([0-3]+)(?:&|$)/.exec(hash);
    if (!match || match[1].length !== TOTAL) return null;
    return match[1].split('').map(Number);
  };

  const updateProgress = () => {
    const count = readAnswers().filter((a) => a !== null).length;
    progress.textContent = `${count} of ${TOTAL} answered`;
  };

  let started = false;
  form.addEventListener('change', (event) => {
    const target = event.target as HTMLInputElement;
    if (target.type !== 'radio') return;
    target.closest('fieldset')?.classList.remove('question--missing');
    if (!started) {
      started = true;
      gtagEvent('readiness_start');
    }
    updateProgress();
  });

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) => {
    const node = document.createElement(tag);
    if (text !== undefined) node.textContent = text;
    if (className) node.className = className;
    return node;
  };

  const linkEl = (link: Link) => {
    const a = el('a', link.label);
    a.href = link.href;
    return a;
  };

  const score = (answers: number[]) => {
    let index = 0;
    const areas = data.areas.map((area) => {
      const points = area.questions.reduce((sum) => sum + answers[index++], 0);
      const max = area.questions.length * 3;
      return { area, points, max, ratio: points / max };
    });
    const points = answers.reduce((a, b) => a + b, 0);
    const ratio = points / (TOTAL * 3);
    let level = [...data.levels].reverse().find((l) => ratio >= l.min) || data.levels[0];
    const weak = areas.filter((a) => a.ratio <= data.weakCap);
    const building = data.levels.find((l) => l.id === 'building')!;
    let capped = false;
    if (weak.length && data.levels.indexOf(level) > data.levels.indexOf(building)) {
      level = building;
      capped = true;
    }
    return { areas, points, ratio, level, weak, capped };
  };

  const render = (answers: number[]) => {
    const r = score(answers);
    document.getElementById('result-level')!.textContent = r.level.name;
    document.getElementById('result-score')!.textContent =
      `Overall score ${r.points} of ${TOTAL * 3} (${Math.round(r.ratio * 100)}%).`;
    document.getElementById('result-summary')!.textContent = r.level.summary;
    document.getElementById('result-focus')!.textContent = `Focus: ${r.level.focus}`;

    const cap = document.getElementById('result-cap')!;
    if (r.capped) {
      cap.textContent = `Your overall score alone would place you higher, but ${r.weak
        .map((w) => w.area.title.toLowerCase())
        .join(' and ')} scored 3 or less out of 9. An agent fails at the weakest point, so the level is held at Building until that changes.`;
      cap.hidden = false;
    } else {
      cap.hidden = true;
    }

    const bars = document.getElementById('result-bars')!;
    bars.replaceChildren(
      ...r.areas.map((a) => {
        const li = el('li');
        const label = el('span', a.area.title, 'bars__label');
        const value = el('span', `${a.points} / ${a.max}`, 'bars__value');
        const track = el('span', undefined, 'bars__track');
        const fill = el('span', undefined, 'bars__fill');
        fill.style.width = `${Math.round(a.ratio * 100)}%`;
        fill.dataset.band = a.ratio <= data.weakCap ? 'weak' : a.ratio < data.strong ? 'mid' : 'strong';
        track.append(fill);
        li.append(label, value, track);
        return li;
      }),
    );

    const steps = document.getElementById('result-steps')!;
    const weakAreas = r.areas.filter((a) => a.ratio < data.strong).sort((x, y) => x.ratio - y.ratio);
    const blocks: HTMLElement[] = [];
    if (weakAreas.length) {
      blocks.push(el('h3', 'Next steps, weakest area first'));
      for (const a of weakAreas) {
        const block = el('div', undefined, 'step');
        block.append(el('h4', `${a.area.title} (${a.points} / ${a.max})`));
        const list = el('ul');
        for (const step of a.area.nextSteps) {
          const li = el('li');
          li.append(el('span', step.text + ' '));
          step.links.forEach((link, i) => {
            if (i > 0) li.append(document.createTextNode(' · '));
            li.append(linkEl(link));
          });
          list.append(li);
        }
        block.append(list);
        blocks.push(block);
      }
    } else {
      blocks.push(el('h3', 'Next steps'));
      blocks.push(
        el('p', 'Every area scored 6 or more out of 9. Keep the evaluation question set running on every change, and expand one domain at a time.'),
      );
    }
    steps.replaceChildren(...blocks);

    const share = `${location.origin}${location.pathname}#answers=${encode(answers)}`;
    (document.getElementById('share-url') as HTMLInputElement).value = share;
    document.getElementById('copy-status')!.textContent = '';
    result.hidden = false;
    return r;
  };

  const fill = (answers: number[]) => {
    questionIds.forEach((id, i) => {
      const input = form.querySelector<HTMLInputElement>(`input[name="${id}"][value="${answers[i]}"]`);
      if (input) input.checked = true;
    });
    updateProgress();
  };

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const answers = readAnswers();
    const missing = questionIds.filter((_, i) => answers[i] === null);
    form.querySelectorAll('.question--missing').forEach((f) => f.classList.remove('question--missing'));
    if (missing.length) {
      missing.forEach((id) => document.getElementById(`fs-${id}`)?.classList.add('question--missing'));
      const numbers = missing.map((id) => questionIds.indexOf(id) + 1);
      error.textContent = `Answer every question to see a result. Still open: ${numbers.join(', ')}.`;
      error.hidden = false;
      document.getElementById(`fs-${missing[0]}`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      document.querySelector<HTMLInputElement>(`input[name="${missing[0]}"]`)?.focus({ preventScroll: true });
      return;
    }
    error.hidden = true;
    const complete = answers as number[];
    const r = render(complete);
    history.replaceState(null, '', `#answers=${encode(complete)}`);
    gtagEvent('readiness_complete', { level: r.level.name, score: r.points });
    result.focus({ preventScroll: true });
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('copy-link')!.addEventListener('click', async () => {
    const input = document.getElementById('share-url') as HTMLInputElement;
    const status = document.getElementById('copy-status')!;
    try {
      await navigator.clipboard.writeText(input.value);
      status.textContent = 'Link copied.';
    } catch {
      input.select();
      status.textContent = 'Select the link and copy it.';
    }
  });

  document.getElementById('restart')!.addEventListener('click', () => {
    form.reset();
    result.hidden = true;
    error.hidden = true;
    started = false;
    history.replaceState(null, '', location.pathname);
    updateProgress();
    form.querySelector<HTMLInputElement>('input[type="radio"]')?.focus();
    window.scrollTo({ top: form.offsetTop - 80, behavior: 'smooth' });
  });

  const loadFromHash = () => {
    const fromHash = decode(location.hash);
    if (!fromHash) return false;
    fill(fromHash);
    render(fromHash);
    result.scrollIntoView({ block: 'start' });
    return true;
  };

  if (!loadFromHash()) updateProgress();
  window.addEventListener('hashchange', loadFromHash);
</script>

<style>
  .readiness { display: grid; gap: 2.5rem; padding: 2rem 0 3.5rem; max-width: 50rem; }

  .area { margin-bottom: 2.5rem; }
  .area__count { font: 600 0.7rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--data); margin: 0 0 0.5rem; }
  .area h2 { margin: 0 0 0.5rem; font-size: 1.6rem; }
  .area__why { color: var(--ink-soft); margin: 0 0 1.4rem; }

  .question { border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper-raised); padding: 1.1rem 1.2rem 1.2rem; margin: 0 0 1rem; min-width: 0; }
  .question legend { font-weight: 650; font-size: 1.02rem; line-height: 1.45; padding: 0 0.3rem; float: left; width: 100%; margin-bottom: 0.85rem; }
  .question legend + * { clear: both; }
  .question__num { color: var(--agent); font-family: var(--mono); font-size: 0.92rem; }
  .question--missing { border-color: var(--warn); box-shadow: 0 0 0 1px var(--warn); }

  .options { display: grid; gap: 0.5rem; }
  .option { display: grid; grid-template-columns: 1.25rem 1fr; gap: 0.7rem; align-items: start; padding: 0.7rem 0.8rem; border: 1px solid var(--rule); border-radius: 8px; cursor: pointer; font-size: 0.95rem; line-height: 1.5; color: var(--ink-soft); }
  .option:hover { border-color: var(--agent); }
  .option input { width: 1.1rem; height: 1.1rem; margin: 0.18rem 0 0; accent-color: var(--agent); }
  .option:has(input:checked) { border-color: var(--agent); background: rgba(124, 92, 255, .07); color: var(--ink); }
  .option:has(input:focus-visible) { outline: 3px solid var(--agent); outline-offset: 2px; }

  .submit-bar { position: sticky; bottom: 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.85rem 1rem; background: rgba(244, 245, 250, .96); border: 1px solid var(--rule); border-radius: var(--radius); backdrop-filter: blur(8px); }
  .submit-bar__progress { margin: 0; font: 600 0.85rem var(--mono); color: var(--ink-soft); min-width: 11ch; }
  .form-error { color: var(--warn); font-weight: 650; margin: 1rem 0 0; }

  .result { background: var(--paper-raised); border: 1px solid var(--rule); border-top: 4px solid var(--result); border-radius: var(--radius); padding: 1.75rem 1.5rem; scroll-margin-top: 5.5rem; }
  .result:focus { outline: none; }
  .result h2 { margin: 0 0 0.6rem; font-size: clamp(2rem, 5vw, 2.8rem); }
  .result :global(h3) { margin: 2rem 0 0.9rem; font-size: 1.2rem; }
  .result :global(h4) { margin: 0 0 0.5rem; font-size: 1.02rem; font-family: var(--display); }
  .result__score { font: 600 0.9rem var(--mono); color: var(--ink-soft); }
  .result__summary { font-size: 1.08rem; }
  .result__cap { border-left: 3px solid var(--warn); padding-left: 0.9rem; color: var(--ink-soft); }
  .result__focus { font-weight: 650; }

  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; }
  .bars :global(li) { display: grid; grid-template-columns: 1fr auto; gap: 0.3rem 1rem; font-size: 0.93rem; }
  .bars :global(.bars__value) { font-family: var(--mono); color: var(--ink-soft); }
  .bars :global(.bars__track) { grid-column: 1 / -1; height: 0.55rem; border-radius: 999px; background: var(--paper); border: 1px solid var(--rule); overflow: hidden; }
  .bars :global(.bars__fill) { display: block; height: 100%; background: var(--data); }
  .bars :global(.bars__fill[data-band='mid']) { background: var(--result); }
  .bars :global(.bars__fill[data-band='weak']) { background: var(--warn); }

  #result-steps :global(.step) { margin-bottom: 1.4rem; }
  #result-steps :global(ul), .result__next ul { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.6rem; color: var(--ink-soft); font-size: 0.96rem; }
  .result :global(a) { color: var(--agent); font-weight: 650; text-underline-offset: 3px; }

  .share { margin-top: 2rem; padding-top: 1.4rem; border-top: 1px solid var(--rule); }
  .share label { display: block; font-weight: 650; margin-bottom: 0.5rem; }
  .share__row { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .share__row input { flex: 1 1 16rem; min-width: 0; font: 0.85rem var(--mono); padding: 0.75rem; border: 1px solid var(--rule); border-radius: 8px; background: var(--paper); color: var(--ink); }
  .share__status { min-height: 1.6em; margin: 0.4rem 0 0.2rem; font-size: 0.88rem; color: var(--data); }
  .linkish { background: none; border: 0; padding: 0; font: inherit; font-size: 0.9rem; color: var(--ink-soft); text-decoration: underline; cursor: pointer; }

  .faq h2 { font-size: 1.5rem; margin: 0 0 1.2rem; }
  .faq__item { border-top: 1px solid var(--rule); padding: 1.1rem 0 0.3rem; }
  .faq__item h3 { font-size: 1.05rem; margin: 0 0 0.45rem; }
  .faq__item p { color: var(--ink-soft); font-size: 0.97rem; }

  @media (max-width: 600px) {
    .question { padding: 0.9rem 0.85rem 1rem; }
    .submit-bar { padding: 0.7rem 0.8rem; }
    .result { padding: 1.4rem 1.1rem; }
  }
</style>
